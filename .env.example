# nuts-sign local settings. Copy to .env; deploy.sh local passes it to the container.
BASE_URL=http://localhost:8090
TIMEZONE=America/Chicago

# Email through AgentMail. Leave blank for console mode (links shown in the UI, nothing sent).
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX_ID=noreply@nuts.services   # an inbox on a domain verified in AgentMail (Console -> Domains)
# AGENTMAIL_BASE_URL=https://api.agentmail.to
# NOTIFY_EMAIL=you@example.com     # also receives the completed copy

# Optional: require this token for admin pages (signing links never need it).
# ADMIN_TOKEN=

# Cloud Run only: mirror envelopes to a bucket so they survive restarts.
# GCS_BUCKET=gnosis-459403-nuts-sign
